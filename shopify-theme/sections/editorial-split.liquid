{% comment %}
  Section éditoriale : sur-titre + titre à gauche, texte (et visuel
  facultatif) à droite. Sert les pages Science / Story / Brand.
  `invert` bascule sur la bande claire (.science), les 8% de bone.
{% endcomment %}
<section class="section{% if section.settings.invert %} science{% endif %}">
  <div class="container {% if section.settings.invert %}science__grid{% else %}split{% endif %}">
    <div data-reveal>
      {%- if section.settings.label != blank -%}
        <span class="eyebrow eyebrow--gold">{{ section.settings.label }}</span>
      {%- endif -%}
      <h2 class="d3">{{ section.settings.heading }}</h2>
    </div>

    <div data-reveal>
      <div class="measure rte">{{ section.settings.body }}</div>

      {%- if section.settings.pull != blank -%}
        <p class="exergue" style="margin-top: 32px">{{ section.settings.pull }}</p>
      {%- endif -%}

      {%- if section.settings.image != blank -%}
        <figure class="imgframe" style="margin-top: 32px; aspect-ratio: {{ section.settings.ratio }}">
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              widths: '400,700,1000,1200',
              sizes: '(max-width: 860px) 100vw, 58vw',
              alt: section.settings.image_alt,
              style: 'object-fit:cover;position:absolute;inset:0;width:100%;height:100%'
          }}
        </figure>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Editorial split",
  "settings": [
    { "type": "text", "id": "label", "label": "Sur-titre", "default": "01 · The material" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Born in burn units." },
    { "type": "richtext", "id": "body", "label": "Texte" },
    { "type": "text", "id": "pull", "label": "Exergue" },
    { "type": "image_picker", "id": "image", "label": "Visuel" },
    { "type": "text", "id": "image_alt", "label": "Texte alternatif" },
    { "type": "select", "id": "ratio", "label": "Format", "default": "1 / 1",
      "options": [
        { "value": "1 / 1", "label": "Carré" },
        { "value": "4 / 3", "label": "Paysage" },
        { "value": "4 / 5", "label": "Portrait" }
      ]
    },
    { "type": "checkbox", "id": "invert", "label": "Bande claire", "default": false }
  ],
  "presets": [{ "name": "Editorial split" }]
}
{% endschema %}
