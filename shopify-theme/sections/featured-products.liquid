<section class="section">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div data-reveal style="margin-bottom: var(--gut)">
        {%- if section.settings.label != blank -%}
          <span class="eyebrow eyebrow--gold">{{ section.settings.label }}</span>
        {%- endif -%}
        <h2 class="d2">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    {%- assign list = section.settings.collection.products -%}
    <div class="cards{% if list.size == 3 %} cards--three{% endif %}" data-reveal-group>
      {%- for product in list limit: section.settings.count -%}
        {% render 'product-card', product: product %}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "label", "label": "Sur-titre", "default": "The range" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Three instruments." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "count", "label": "Nombre", "min": 2, "max": 12, "step": 1, "default": 3 }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
