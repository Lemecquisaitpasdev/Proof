{% comment %}
  HONOR YOUR STORY — spread éditorial.
  Deux colonnes indépendantes : à gauche l'intro, le tirage B incliné et
  la citation ; à droite le cliché couleur A puis le tirage C. En mobile
  les colonnes se déplient (display:contents) pour que le cliché couleur
  passe juste après le titre — cf. les règles .honor__* du CSS.
{% endcomment %}
{%- if section.settings.headline != blank -%}
  <section class="section honor" aria-label="{{ section.settings.headline | escape }}">
    <div class="container">
      <div class="honor__scatter">
        <div class="honor__col honor__col--lead">
          <header class="honor__intro" data-reveal>
            {%- if section.settings.label != blank -%}
              <span class="mlabel mlabel--gold">{{ section.settings.label }}</span>
            {%- endif -%}
            <h2 class="d2 honor__head">{{ section.settings.headline }}</h2>
            <p class="honor__lead">{{ section.settings.lead }}</p>
          </header>

          {%- if section.settings.image_b != blank -%}
            <figure class="honor__fig honor__fig--b" data-reveal>
              {{ section.settings.image_b | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '400,700,1100', sizes: '(max-width: 900px) 90vw, 42vw', alt: section.settings.alt_b }}
              <figcaption>{{ section.settings.caption_b }}</figcaption>
            </figure>
          {%- endif -%}

          {%- if section.settings.quote != blank -%}
            <p class="honor__quote" data-reveal>{{ section.settings.quote }}</p>
          {%- endif -%}
        </div>

        <div class="honor__col honor__col--main">
          {%- if section.settings.image_a != blank -%}
            <figure class="honor__fig honor__fig--a" data-reveal>
              {{ section.settings.image_a | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400,700,1200', sizes: '(max-width: 900px) 90vw, 42vw', alt: section.settings.alt_a }}
              <figcaption>{{ section.settings.caption_a }}</figcaption>
            </figure>
          {%- endif -%}

          {%- if section.settings.image_c != blank -%}
            <figure class="honor__fig honor__fig--c" data-reveal>
              {{ section.settings.image_c | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400,700,1000', sizes: '(max-width: 900px) 90vw, 30vw', alt: section.settings.alt_c }}
              <figcaption>{{ section.settings.caption_c }}</figcaption>
            </figure>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Honor your story",
  "settings": [
    { "type": "text", "id": "label", "label": "Sur-titre", "default": "Portraits — worn, not hidden" },
    { "type": "text", "id": "headline", "label": "Titre", "default": "Honor your story." },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Chapô",
      "default": "Every scar closes one story and opens another — a birth, a repair, a night that left its mark. Proof was never built to erase them; it helps the skin settle and soften, so what you carry stays yours to show, on your own terms."
    },
    { "type": "header", "content": "Cliché couleur (pôle droit)" },
    { "type": "image_picker", "id": "image_a", "label": "Image" },
    { "type": "text", "id": "alt_a", "label": "Texte alternatif" },
    { "type": "text", "id": "caption_a", "label": "Légende", "default": "On her own terms" },
    { "type": "header", "content": "Tirage de gauche" },
    { "type": "image_picker", "id": "image_b", "label": "Image" },
    { "type": "text", "id": "alt_b", "label": "Texte alternatif" },
    { "type": "text", "id": "caption_b", "label": "Légende", "default": "Softer, frame by frame" },
    { "type": "header", "content": "Tirage bas de page" },
    { "type": "image_picker", "id": "image_c", "label": "Image" },
    { "type": "text", "id": "alt_c", "label": "Texte alternatif" },
    { "type": "text", "id": "caption_c", "label": "Légende", "default": "The line, and the life after" },
    { "type": "header", "content": "Citation" },
    { "type": "text", "id": "quote", "label": "Citation", "default": "A scar is proof you healed." }
  ],
  "presets": [{ "name": "Honor your story" }]
}
{% endschema %}
