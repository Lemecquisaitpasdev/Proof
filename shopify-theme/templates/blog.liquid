<section class="pagehead section">
  <div class="container">
    <span class="mlabel">Journal</span>
    <h1 class="d1" style="margin-top: 16px">{{ blog.title }}</h1>
    <ul style="margin-top: 40px">
      {%- for article in blog.articles -%}
        <li style="margin-top: 20px">
          <a href="{{ article.url }}" class="klink">{{ article.title }}</a>
          <span class="mlabel" style="display:block">{{ article.published_at | date: '%B %d, %Y' }}</span>
        </li>
      {%- endfor -%}
    </ul>
    {{ paginate | default_pagination }}
  </div>
</section>
