<section class="pagehead section">
  <div class="container">
    <span class="mlabel">Search / The file</span>
    <h1 class="d1" style="margin-top: 16px">Search</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" style="margin-top: 28px">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search" class="news__input" aria-label="Search">
      <button type="submit" class="btn btn--ghost" style="margin-top: 12px">Search</button>
    </form>

    {%- if search.performed -%}
      <div class="cards" style="margin-top: 48px" data-reveal-group>
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}{% render 'product-card', product: item %}{%- endif -%}
        {%- else -%}
          <p class="lead">{{ 'general.search.no_results' | t: terms: search.terms }}</p>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>
